{
  "apiVersion": 3,
  "manifest": {
    "id": "example.enterprise-ops",
    "name": "Enterprise Operations",
    "version": "1.0.0",
    "publisher": "SpentaCRM Examples",
    "description": "Enterprise operations suite with multiple CRM extension points.",
    "complexity": "professional",
    "categories": [
      "module"
    ],
    "permissions": [
      "runtime:sandbox",
      "ui:navigation",
      "ui:dashboard",
      "ui:entity-tabs",
      "ui:entity-actions"
    ]
  },
  "contributes": {
    "runtimePages": [
      {
        "id": "workspace",
        "title": "Enterprise Operations",
        "description": "Enterprise operations suite with multiple CRM extension points.",
        "entry": "dist/pages/workspace.html",
        "navigation": {
          "label": "Enterprise Operations",
          "section": "extensions"
        },
        "height": "viewport"
      }
    ],
    "runtimeDashboardWidgets": [
      {
        "id": "summary",
        "title": "Enterprise Operations summary",
        "zone": "dashboard.afterStats",
        "entry": "dist/widgets/summary.html",
        "height": 220
      }
    ],
    "runtimeEntityTabs": [
      {
        "id": "company-module",
        "entity": "company",
        "label": "Enterprise Operations",
        "entry": "dist/tabs/company.html",
        "height": 300
      },
      {
        "id": "deal-operations",
        "entity": "deal",
        "label": "Enterprise Ops",
        "entry": "dist/tabs/deal.html",
        "height": 320
      }
    ],
    "runtimeEntityActions": [
      {
        "id": "open-workspace",
        "entity": "company",
        "label": "Open Enterprise Operations",
        "tone": "primary",
        "action": {
          "type": "open-page",
          "pageId": "workspace"
        }
      }
    ]
  }
}