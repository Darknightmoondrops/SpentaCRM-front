{
  "apiVersion": 3,
  "manifest": {
    "id": "example.quick-notes",
    "name": "Quick Notes",
    "version": "1.0.0",
    "publisher": "SpentaCRM Examples",
    "description": "A small local notes workspace.",
    "complexity": "simple",
    "categories": [
      "module"
    ],
    "permissions": [
      "runtime:sandbox",
      "ui:navigation"
    ]
  },
  "contributes": {
    "runtimePages": [
      {
        "id": "workspace",
        "title": "Quick Notes",
        "description": "A small local notes workspace.",
        "entry": "dist/pages/workspace.html",
        "navigation": {
          "label": "Quick Notes",
          "section": "extensions"
        },
        "height": "viewport"
      }
    ]
  }
}