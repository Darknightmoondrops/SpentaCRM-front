{
  "name": "spentacrm-frontend",
  "version": "0.13.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "extensions:sync": "node scripts/sync-extensions.mjs",
    "extension:add": "node scripts/manage-extension.mjs add",
    "extension:remove": "node scripts/manage-extension.mjs remove",
    "predev": "npm run extensions:sync",
    "prebuild": "npm run extensions:sync"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@spentacrm/extension-sdk": "file:packages/extension-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.8.3",
    "babel-plugin-react-compiler": "1.0.0"
  }
}
