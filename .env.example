# API + authentication adapter
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_AUTH_ADAPTER=mock
# In production set NEXT_PUBLIC_AUTH_ADAPTER=api and let NestJS issue secure session/refresh cookies.


# Optional public/white-label product configuration
NEXT_PUBLIC_APP_NAME=SpentaCRM
NEXT_PUBLIC_APP_SHORT_NAME=Spenta
NEXT_PUBLIC_APP_TAGLINE=Modular B2B CRM platform
NEXT_PUBLIC_APP_VERSION=v0.13.2
NEXT_PUBLIC_WORKSPACE_NAME=Demo Workspace
NEXT_PUBLIC_WORKSPACE_PLAN=Business
NEXT_PUBLIC_DEMO_USER_NAME=Alex Morgan
NEXT_PUBLIC_DEMO_USER_EMAIL=alex@example.com
NEXT_PUBLIC_DEMO_USER_INITIALS=AM
NEXT_PUBLIC_DEMO_USER_ROLE=Administrator
NEXT_PUBLIC_LOCALE=en-GB
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Europe/Berlin
